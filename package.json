{
  "name": "mogawa-dev",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-content": "bun run scripts/generate-content.ts",
    "generate-feeds": "bun run scripts/generate-feeds.ts",
    "build": "bun run generate-feeds && vite build",
    "preview": "vite preview",
    "typecheck": "bun run generate-content && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.49",
    "date-fns": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@content-collections/core": "^0.15.2",
    "@content-collections/vite": "^0.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2",
    "vite": "^7.1.7",
    "wrangler": "^4.24.0"
  },
  "packageManager": "bun@1.3.11"
}
