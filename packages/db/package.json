    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
