{
  "name": "@mogawa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app-type": {
      "types": "./src/app-type.ts",
      "default": "./src/app-type.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.4",
    "@hono/standard-validator": "^0.1.5",
    "@mogawa/db": "workspace:*",
    "@mogawa/schemas": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.10",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250712.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.0"
  }
}
