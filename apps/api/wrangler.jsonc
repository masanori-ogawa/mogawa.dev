{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mogawa-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONSOLE_ORIGIN": "http://localhost:3001",
    "SITE_ORIGIN": "http://localhost:3000"
  }
}
